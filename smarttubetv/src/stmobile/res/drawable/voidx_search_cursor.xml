<?xml version="1.0" encoding="utf-8"?>
<!-- VOIDXDEV(search glow): the search cursor in Siri's colours, as iOS 27's Search or Ask bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:width="2dp" />
    <corners android:radius="1dp" />
    <gradient
        android:angle="270"
        android:centerColor="#FFB45CFF"
        android:endColor="#FF5E9BFF"
        android:startColor="#FFFF6A88" />
</shape>
