<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings search page: the results fill the page and the field (back, query, clear) floats
     over their top as frosted glass (Glass.blur), so they scroll under it. A GlassSource may not
     hold the glass that samples it, hence the FrameLayout around both. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.newtube.mobile.ui.common.GlassSource
        android:id="@+id/settings_search_blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_color_background">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="68dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_mobile_settings_search_result" />

        <TextView
            android:id="@+id/settings_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingTop="112dp"
            android:paddingEnd="32dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="No settings match “xyz”"
            tools:visibility="visible" />

    </com.newtube.mobile.ui.common.GlassSource>

    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/settings_search_glass"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:elevation="6dp"
        app:glassCornerRadius="26dp"
        app:glassTint="@color/voidx_glass_tint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/settings_search_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_dialog_back"
            android:padding="10dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <EditText
            android:id="@+id/settings_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/mobile_settings_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:textColor="@color/mobile_color_on_surface"
            android:textColorHint="@color/mobile_color_on_surface_secondary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/settings_search_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_clear"
            android:padding="10dp"
            android:src="@drawable/ic_sheet_close"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    </com.newtube.mobile.ui.common.GlassView>

</FrameLayout>
