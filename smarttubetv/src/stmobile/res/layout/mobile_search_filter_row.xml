<?xml version="1.0" encoding="utf-8"?>
<!-- VOIDXDEV(search filters): one dropdown row - label, then the chosen value with a chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/mobile_search_filter_label"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/mobile_search_filter_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableEnd="@drawable/ic_watch_expand"
        android:gravity="center_vertical"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
