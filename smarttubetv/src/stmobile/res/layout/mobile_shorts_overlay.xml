<?xml version="1.0" encoding="utf-8"?>
<!-- VOIDXDEV(shorts): the vertical player's overlay (ShortsOverlay), laid out like YouTube's Shorts:
     channel row (avatar, name, Subscribe), title and views bottom-left; like / dislike / comments /
     share bottom-right; a thin progress line at the very bottom; the play/pause flash and the
     double-tap heart in the middle. Text carries shadows over a light scrim; the buttons and the
     flash are frosted discs of the video (VOIDXDEV(glass), set in ShortsOverlay). The actions
     forward to the watch page's own buttons. The peek is the next (or previous) short's portrait
     thumbnail that follows a swipe in from the edge, outside this box (clipChildren off). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_shorts_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/mobile_shorts_peek"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:alpha="0.6"
        android:background="@drawable/mobile_player_top_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_shorts_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:text="@string/header_shorts"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:alpha="0.55"
        android:background="@drawable/mobile_player_bottom_scrim"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/mobile_shorts_flash"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/ic_player_play"
        android:tint="@android:color/white" />

    <ImageView
        android:id="@+id/mobile_shorts_heart"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_watch_thumb_up"
        android:tint="@color/mobile_color_primary" />

    <LinearLayout
        android:id="@+id/mobile_shorts_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mobile_shorts_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shorts_avatar"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/mobile_shorts_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="170dp"
                android:shadowColor="#B3000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="\@channel" />

            <TextView
                android:id="@+id/mobile_shorts_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_shorts_subscribe"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/mobile_watch_subscribe"
                android:textColor="@color/mobile_shorts_subscribe_text"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/mobile_shorts_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="A short's title that may run onto a second line" />

        <TextView
            android:id="@+id/mobile_shorts_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            tools:text="1.2M views · 3 days ago" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mobile_shorts_actions"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/mobile_shorts_like"
            style="@style/VoidTubeShortsAction"
            android:contentDescription="@string/mobile_watch_like"
            android:src="@drawable/ic_watch_thumb_up_outline" />

        <TextView
            android:id="@+id/mobile_shorts_like_count"
            style="@style/VoidTubeShortsActionLabel"
            android:text="@string/mobile_watch_like" />

        <ImageButton
            android:id="@+id/mobile_shorts_dislike"
            style="@style/VoidTubeShortsAction"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/mobile_watch_dislike"
            android:src="@drawable/ic_watch_thumb_down_outline" />

        <TextView
            style="@style/VoidTubeShortsActionLabel"
            android:text="@string/mobile_watch_dislike" />

        <ImageButton
            android:id="@+id/mobile_shorts_comments"
            style="@style/VoidTubeShortsAction"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/mobile_comments_title"
            android:src="@drawable/ic_watch_comment" />

        <TextView
            android:id="@+id/mobile_shorts_comments_count"
            style="@style/VoidTubeShortsActionLabel"
            android:text="@string/mobile_comments_title" />

        <ImageButton
            android:id="@+id/mobile_shorts_share"
            style="@style/VoidTubeShortsAction"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/mobile_watch_share"
            android:src="@drawable/ic_watch_share" />

        <TextView
            style="@style/VoidTubeShortsActionLabel"
            android:text="@string/mobile_watch_share" />

        <ImageButton
            android:id="@+id/mobile_shorts_more"
            style="@style/VoidTubeShortsAction"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/mobile_menu_more"
            android:src="@drawable/ic_mobile_more_vert" />

        <!-- YouTube's spinning disc: the channel's picture, turning while the short plays. -->
        <ImageView
            android:id="@+id/mobile_shorts_disc"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_shorts_disc"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <!-- The time while scrubbing, big, like YouTube's. -->
    <TextView
        android:id="@+id/mobile_shorts_seek_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#B3000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:visibility="gone"
        tools:text="0:12 / 0:45"
        tools:visibility="visible" />

    <!-- A thin line that scrubs: the thumb shows while a finger holds it, the seek lands on release. -->
    <SeekBar
        android:id="@+id/mobile_shorts_progress"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:background="@null"
        android:max="1000"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressDrawable="@drawable/voidx_shorts_seek"
        android:splitTrack="false"
        android:thumb="@drawable/voidx_shorts_seek_thumb"
        android:thumbOffset="0dp" />

</FrameLayout>
