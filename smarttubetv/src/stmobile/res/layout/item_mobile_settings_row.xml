<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row: optional leading icon (top-level pages), title, optional summary (what it
     does, or the current value of a choice), optional trailing switch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/mobile_settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/mobile_settings_row_inset"
    android:paddingEnd="@dimen/mobile_settings_row_inset">

    <ImageView
        android:id="@+id/settings_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/mobile_settings_icon_gap"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/mobile_color_on_surface"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/mobile_settings_row_padding_vertical"
        android:paddingBottom="@dimen/mobile_settings_row_padding_vertical">

        <TextView
            android:id="@+id/settings_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="@dimen/mobile_settings_row_title_size"
            tools:text="Background play" />

        <TextView
            android:id="@+id/settings_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="@dimen/mobile_settings_row_summary_size"
            android:visibility="gone"
            tools:text="Keep listening with the screen off"
            tools:visibility="visible" />

    </LinearLayout>

    <com.newtube.mobile.ui.common.GlassSwitch
        android:id="@+id/settings_row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</LinearLayout>
