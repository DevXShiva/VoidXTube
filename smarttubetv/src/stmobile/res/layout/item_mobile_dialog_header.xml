<?xml version="1.0" encoding="utf-8"?>
<!-- Section header row for an OptionCategory.title (radio/checkbox/string-list categories): the
     Settings group-title style (item_mobile_settings_header), so headers never read as options. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_header_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityHeading="true"
    android:fontFamily="sans-serif-medium"
    android:letterSpacing="0.02"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:textColor="@color/mobile_color_section_title"
    android:textSize="@dimen/mobile_settings_header_size"
    tools:text="Video quality" />
