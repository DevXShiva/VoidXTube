<?xml version="1.0" encoding="utf-8"?>
<!--
  VOIDXDEV(description): YouTube's Description panel, opened from the watch page's title. A title +
  close header, then the video title, a Likes / Views / date row (DescriptionSheet fills it) and the
  description. Title and description are selectable: long-press to copy; links still open on a tap.
  The frame is the frosted sheet glass; its height is capped from code so it stops under the video.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mobile_watch_description"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/description_sheet_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_sheet_close"
            android:src="@drawable/ic_sheet_close" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_color_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/description_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mobile_color_on_surface"
                android:textIsSelectable="true"
                android:textSize="18sp"
                tools:text="Rick Astley - Never Gonna Give You Up (Official Video)" />

            <!-- Likes / Views / date columns, as on YouTube. -->
            <LinearLayout
                android:id="@+id/description_sheet_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/description_sheet_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:autoLink="web"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/mobile_color_on_surface"
                android:textColorLink="@color/mobile_color_link"
                android:textIsSelectable="true"
                android:textSize="14sp"
                tools:text="The official video for Never Gonna Give You Up by Rick Astley." />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
