<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Chapters sheet, YouTube's anatomy: the chapter's 16:9 frame, then its title and
     start time. The chapter that is playing gets a filled background (ChaptersSheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="112dp"
        android:layout_height="63dp"
        app:cardBackgroundColor="@color/mobile_color_placeholder"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/chapter_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="15sp"
            tools:text="Working With Strings" />

        <TextView
            android:id="@+id/chapter_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            tools:text="52:37" />

    </LinearLayout>

</LinearLayout>
