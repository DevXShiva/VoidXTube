<?xml version="1.0" encoding="utf-8"?>
<!-- VOIDXDEV(search filters, #11): YouTube's own "Search filters" dialog - four dropdown rows
     (SearchFiltersDialog fills them) and the Features chips. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/mobile_search_filters_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/mobile_search_filters_features_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mobile_search_filter_features"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="15sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/mobile_search_filters_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
