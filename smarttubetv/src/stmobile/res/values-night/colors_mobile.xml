    <color name="mobile_color_surface">#1C1C21</color>
    <color name="mobile_color_on_surface">#F5F5F7</color>
    <color name="mobile_color_section_title">#8B5CF6</color>
    <color name="mobile_color_on_surface_secondary">#99FFFFFF</color>
    <color name="mobile_color_placeholder">#1C1C21</color>
    <!-- NEWTUBE(motion): the light that sweeps over skeleton blocks (ShimmerLinearLayout). -->
    <color name="mobile_color_skeleton_highlight">#2C2C32</color>
    <color name="mobile_color_link">#64D2FF</color>
    <color name="mobile_color_divider">#1FFFFFFF</color>
    <color name="mobile_color_pill">#1FFFFFFF</color>
    <color name="mobile_color_subscribed_button">#2C2C32</color>
