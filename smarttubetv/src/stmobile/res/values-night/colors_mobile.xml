    <color name="voidx_sheet_glass">#C71C1C21</color>
    <color name="voidx_glass_fill">#17FFFFFF</color>
    <color name="voidx_glass_stroke">#24FFFFFF</color>
    <color name="voidx_glass_selected">#24FFFFFF</color>
    <color name="voidx_nav_inactive">#ADFFFFFF</color>
    <!-- VOIDXDEV(glass): the frosted top bar - the page colour at ~75%. -->
    <color name="voidx_bar_tint">#B8000000</color>
    <color name="voidx_switch_off">#3A3A3F</color>
    <color name="voidx_accent">#8B5CF6</color>
