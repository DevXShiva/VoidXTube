    <color name="mobile_color_background_scrim">#66000000</color>
    <color name="mobile_color_navigation_bar">#000000</color>

    <!-- The shared edit dialogs keep the library's AppDialog colours (sharedutils / common). -->
    <color name="dialog_bg_color">#101010</color>
    <color name="dialog_text_color">#a1a1a6</color>
    <color name="dialog_hint_color">#33FFFFFF</color>
    <color name="dialog_proxy_hint_color">#80FFFFFF</color>

    <!-- VOIDXDEV(glass): BitChord's glass tint (#121212 at 40%), 14% white hairline, 14% white lit tab. -->
    <color name="voidx_glass_tint">#66000000</color>
    <color name="voidx_search_glass_tint">#26FFFFFF</color>
